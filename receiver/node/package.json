{
  "name": "folder-camera-receiver",
  "version": "1.3.0",
  "description": "Folder Camera's receiver engine for Node: pairing, certificate-pinned HTTPS uploads, durable receipts. Embedded by apps that run their own receiver.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigmasd/folder-camera.git",
    "directory": "receiver/node"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@peculiar/x509": "2.1.0",
    "@types/qrcode": "1.5.5",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
