{
  "tasks": {
    "start": "deno run --allow-env=HOME,XDG_STATE_HOME,LOCALAPPDATA --allow-sys=networkInterfaces,homedir --allow-net --allow-read --allow-write --allow-run=openssl src/main.ts",
    "test": "deno test --allow-read --allow-write --allow-net=127.0.0.1 --allow-env=HOME,XDG_STATE_HOME,LOCALAPPDATA,SystemRoot --allow-sys=networkInterfaces,homedir --allow-ffi tests",
    "check": "deno check src/main.ts desktop/main.ts tests/*.ts",
    "lint": "deno lint src desktop tests",
    "fmt": "deno fmt src desktop tests deno.json",
    "preview": "deno run --allow-read --allow-net=127.0.0.1 desktop/preview.ts"
  },
  "compilerOptions": {
    "strict": true
  },
  "lock": true,
  "imports": {
    "@peculiar/x509": "npm:@peculiar/x509@2.1.0",
    "qrcode": "npm:qrcode@1.5.4",
    "qrcode-types": "npm:@types/qrcode@1.5.5",
    "reflect-metadata": "npm:reflect-metadata@0.2.2"
  },
  "name": "folder-camera-receiver",
  "version": "1.0.0",
  "desktop": {
    "app": {
      "name": "Folder Camera Receiver",
      "identifier": "io.github.sigmasd.foldercamera.receiver"
    },
    "backend": "webview"
  },
  "exports": "./desktop/main.ts"
}
