{
  "tasks": {
    "start": "deno run --allow-env=HOME,XDG_STATE_HOME,LOCALAPPDATA --allow-sys=networkInterfaces,homedir --allow-net --allow-read --allow-write --allow-run=openssl src/main.ts",
    "test": "deno test --allow-read --allow-write --allow-net=127.0.0.1 --allow-run=openssl tests",
    "check": "deno check src/main.ts tests/*.ts",
    "lint": "deno lint src tests",
    "fmt": "deno fmt src tests deno.json"
  },
  "compilerOptions": {
    "strict": true
  },
  "lock": true,
  "imports": {
    "qrcode": "npm:qrcode@1.5.4",
    "qrcode-types": "npm:@types/qrcode@1.5.5"
  }
}
